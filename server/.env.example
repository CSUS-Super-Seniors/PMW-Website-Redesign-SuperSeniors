# Copy to server/.env and fill in. Never commit the real .env file.

PORT=3001
NODE_ENV=development
CLIENT_ORIGINS=http://localhost:5173

SUPABASE_URL=https://wqfctrxotdrugutcwlvv.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Set all three to enable contact messages. With all three blank, only the
# contact endpoint is unavailable; other API routes keep working.
RESEND_API_KEY=
# Bare email address on a domain verified in Resend.
RESEND_FROM_EMAIL=
# Comma-separated owner email addresses (Todd and Girlie).
CONTACT_OWNER_EMAILS=

# Sample data seed (npm run db:seed). Local Supabase database:
SEED_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Dev and staging Supabase project refs the seed may run against (comma-separated).
# Never add the production project.
SEED_ALLOWED_PROJECT_REFS=
# Production project ref(s). The seed always refuses these, even if listed above.
SEED_BLOCKED_PROJECT_REFS=
# Local database for npm run test:seed (its changes are rolled back). Leave blank to skip.
SEED_TEST_DATABASE_URL=
