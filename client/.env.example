# Copy to client/.env and fill in. Never commit the real .env file.
# Local values: run `npm run db:start`, then `npx supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional Contact page preview while SSPMW-268 (C5) is pending.
# Use success or failure, then restart Vite. Leave empty to call the API.
# Ignored in production builds; preview submissions are not saved or emailed.
VITE_CONTACT_FORM_STUB=
